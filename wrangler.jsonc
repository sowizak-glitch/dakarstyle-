{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dakarstyle",
  "main": "src/index.js",
  "compatibility_date": "2026-05-21",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/visuals/api/*",
      "/visuals/media/*",
      "/visuals/manifest/*",
      "/sowhat-performance-dashboard*"
    ]
  },
  "r2_buckets": [
    {
      "binding": "VISUALS_BUCKET",
      "bucket_name": "dakarstyle-visuals"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
